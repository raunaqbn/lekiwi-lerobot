[Unit]
Description=LeKiwi v0.6.1 follower host and embedded diagnostics
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=raunaqnaidu
WorkingDirectory=/home/raunaqnaidu/lerobot-v061
Environment=HF_LEROBOT_HOME=/home/raunaqnaidu/.cache/huggingface/lerobot-v061
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/raunaqnaidu/miniconda3/envs/lerobot061/bin/python -m lerobot.robots.lekiwi.lekiwi_host --robot.id=anton
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
