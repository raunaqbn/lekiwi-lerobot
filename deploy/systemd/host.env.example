# Copy to ~/.config/lekiwi/host.env on the Raspberry Pi.
LEKIWI_FOLLOWER_PORT=/dev/serial/by-id/usb-REPLACE_ME
LEKIWI_FRONT_CAMERA=/dev/v4l/by-id/usb-REPLACE_FRONT-camera-index0
LEKIWI_WRIST_CAMERA=/dev/v4l/by-id/usb-REPLACE_WRIST-camera-index0
LEKIWI_ROBOT_ID=lekiwi
LEKIWI_DIAGNOSTICS_HOST=0.0.0.0
HF_LEROBOT_HOME=/home/REPLACE_ME/.cache/huggingface/lerobot
